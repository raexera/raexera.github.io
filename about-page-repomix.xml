<file path="src/components/Experience.astro">
---
import ExpandButton from "./ExpandButton";
import Section from "./Section.astro";
import { work } from "@cv";
---

<Section className={Astro.props.className} title="Experience">
  <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-[auto_auto_1fr] sm:gap-x-8">
    {
      work.map(
        (
          {
            name,
            startDate,
            endDate,
            position,
            summary,
            responsibilities,
            url,
            location,
            location_type,
          },
          index,
        ) => {
          const isLastItem = index === work.length - 1;

          const d1 = new Date(startDate);
          const d2 = endDate ? new Date(endDate) : new Date();

          const dateOptions: Intl.DateTimeFormatOptions = {
            month: "short",
            year: "numeric",
          };

          const formattedStartDate = d1.toLocaleString("en-US", dateOptions);
          const formattedEndDate = endDate
            ? d2.toLocaleString("en-US", dateOptions)
            : "Present";

          let years = d2.getFullYear() - d1.getFullYear();
          let months = d2.getMonth() - d1.getMonth();

          if (months < 0) {
            years--;
            months += 12;
          }

          if (!endDate) {
            months += 1;
            if (months === 12) {
              years += 1;
              months = 0;
            }
          }

          const durationParts = [];
          if (years > 0) {
            durationParts.push(`${years} yr${years > 1 ? "s" : ""}`);
          }
          if (months > 0) {
            durationParts.push(`${months} mo${months > 1 ? "s" : ""}`);
          }
          const duration = durationParts.join(" ");

          return (
            <>
{/* Datetime */}
              <div class="mt-1 text-xs font-medium text-muted-foreground">
                <div>
                  <time datetime={startDate}>{formattedStartDate}</time>
                  <span class="mx-1">-</span>
                  <time datetime={endDate}>{formattedEndDate}</time>
                </div>
                {duration && <div class="font-normal">{duration}</div>}
              </div>

              {/* Timeline */}
              <div class="relative hidden justify-center sm:flex">
                {!isLastItem && (
                  <div class="absolute top-3 h-full w-px bg-border" />
                )}
                {/* Changed to bg-card and ring-card to match the new Section container */}
                <div class="relative z-10 mt-1.5 h-2.5 w-2.5 rounded-full border border-border bg-card ring-4 ring-card" />
              </div>

              {/* Content */}
              <div class={isLastItem ? "" : "mb-8"}>
                <div class="font-bold text-foreground">
                  {position} <span>@</span>
                  {url ? (
                    <a
                      class="inline-flex items-center transition-colors hover:text-muted-foreground"
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {name}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="ml-1 h-4 w-4 shrink-0 translate-y-px"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </a>
                  ) : (
                    name
                  )}
                </div>
                {(location || location_type) && (
                  <p class="mt-2 text-sm text-muted-foreground">
                    {location} {location && location_type && " - "}{" "}
                    {location_type}
                  </p>
                )}
                <div class="mt-2 space-y-4 text-sm">
                  {summary && (
                    <ul class="text-muted-foreground">
                      {Array.isArray(summary) ? (
                        summary.map((item) => <li>{item}</li>)
                      ) : (
                        <li>{summary}</li>
                      )}
                    </ul>
                  )}
                  {responsibilities && (
                    <ExpandButton client:load>
                      <div class="mt-2 text-sm">
                        <div class="font-medium text-muted-foreground">
                          Responsibilities:
                        </div>
                        <ul class="list-inside list-disc space-y-1 text-muted-foreground">
                          {responsibilities.map((responsibility) => (
                            <li>{responsibility}</li>
                          ))}
                        </ul>
                      </div>
                    </ExpandButton>
                  )}
                </div>
              </div>
            </>
          );
        },
      )
    }
  </div>
</Section>
</file>

<file path="src/components/Section.astro">
