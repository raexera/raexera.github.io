<file path="src/components/Skills.astro">
---
import { skills } from "@cv";
import Section from "./Section.astro";

const {
  programming_languages,
  cloud_platforms,
  infrastructure_devops,
  observability_security,
} = skills;

const skillCategories = [
  { title: "Programming Languages", items: programming_languages },
  { title: "Cloud Platforms", items: cloud_platforms },
  {
    title: "Containers & Orchestration",
    items: infrastructure_devops.orchestration,
  },
  { title: "Infrastructure as Code", items: infrastructure_devops.iac },
  { title: "CI/CD & GitOps", items: infrastructure_devops.ci_cd },
  { title: "Operating Systems", items: infrastructure_devops.os },
  {
    title: "Monitoring & Alerting",
    items: observability_security.monitoring_alerting,
  },
  { title: "Security", items: observability_security.security },
  { title: "Testing", items: observability_security.testing },
];
---

<Section className={Astro.props.className} title="Skills">
  <div class="flex flex-col space-y-4">
    {
      skillCategories.map(({ title, items }) => (
<div class="flex flex-col sm:flex-row sm:items-center">
          <span class="w-full text-sm font-semibold text-foreground sm:w-48">
            {title}
          </span>
          <span class="hidden px-2 sm:inline-block text-muted-foreground">:</span>
          <ul class="flex flex-1 flex-wrap gap-2">
            {items.map((item: string) => (
              <li class="inline-flex items-center rounded-md border border-border bg-muted/50 px-2.5 py-0.5 text-xs font-medium text-foreground transition-colors hover:bg-muted">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
</file>

<file path="src/pages/about.astro">
---
import Awards from "@/components/Awards.astro";
import Education from "@/components/Education.astro";
import Experience from "@/components/Experience.astro";
import Skills from "@/components/Skills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/consts";
---

<BaseLayout title="About" description={SITE.DESCRIPTION}>
  <div class="container mx-auto max-w-5xl py-24 sm:py-32">

    {/* Page Header */}
    <div class="mb-12 flex flex-col gap-4">
      <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-6xl">
        About Me
      </h1>
      <p class="text-lg text-muted-foreground">
        My professional background, experience, and skills.
      </p>
    </div>

    {/* Bento Grid */}
    <div class="grid grid-cols-1 gap-4">
      <Experience />
      <Skills />

      {/* 2-Column Split for smaller sections */}
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <Education />
        <Awards />
      </div>
    </div>

  </div>
</BaseLayout>
</file>

