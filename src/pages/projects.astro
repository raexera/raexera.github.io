---
import Card from "@/components/Card.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/consts";
import { projects } from "@cv";
---

<BaseLayout title="Projects" description={SITE.DESCRIPTION}>
  <div class="container mx-auto max-w-5xl py-24 sm:py-32">
    <div class="mb-12 flex flex-col gap-4">
      <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-6xl">
        My Projects
      </h1>
      <p class="text-lg text-muted-foreground">
        A collection of my work, experiments, and contributions.
      </p>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
      {
        projects.map(({ url, name, description, highlights, technologies }) => (
          <Card
            url={url}
            description={description}
            highlights={highlights}
            name={name}
            technologies={technologies}
          />
        ))
      }
    </div>

  </div>
</BaseLayout>
