---
type Props = {
  className?: string;
  title?: string;
};

const { className = "", title } = Astro.props;
---

<section
  class:list={[
    "flex flex-col rounded-2xl border border-border bg-card p-6 sm:p-10",
    className,
  ]}
>
  {
    title && (
      <h2 class="mb-8 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
        {title}
      </h2>
    )
  }
  <slot />
</section>
