---
import { skills } from "@cv";
import Section from "./Section.astro";

const {
  programming_languages,
  cloud_platforms,
  infrastructure_devops,
  observability,
} = skills;

const skillCategories = [
  { title: "Programming Languages", items: programming_languages },
  { title: "Cloud Platforms", items: cloud_platforms },
  {
    title: "Containers & Orchestration",
    items: infrastructure_devops.orchestration,
  },
  { title: "Infrastructure as Code", items: infrastructure_devops.iac },
  { title: "CI/CD & GitOps", items: infrastructure_devops.ci_cd },
  { title: "Operating Systems", items: infrastructure_devops.os },
  {
    title: "Monitoring & Alerting",
    items: observability.monitoring_alerting,
  },
  { title: "Testing", items: observability.testing },
];
---

<Section className={Astro.props.className} title="Skills">
  <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
    {
      skillCategories.map(({ title, items }) => (
        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-semibold tracking-tight text-foreground">
            {title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {items.map((item: string) => (
              <li class="inline-flex cursor-default items-center rounded-md bg-muted/40 px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-foreground hover:text-background">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
