---
import { SITE } from "@/consts";
---

<footer class="relative mt-auto hidden w-full md:block print:hidden">
  <div class="container mx-auto max-w-5xl">
    <section class="border-t border-border py-8">
      <div class="flex items-center justify-center">
        <p class="text-sm tracking-tight text-muted-foreground">
          &copy; {new Date().getFullYear()} {SITE.AUTHOR}. All rights reserved.
        </p>
      </div>
    </section>
  </div>
</footer>
