---
import { Icon } from "astro-icon/components";

type Props = {
  id: string;
};

const { id } = Astro.props;
---

<button
  id={id}
  aria-label="Toggle light and dark theme"
  class="flex size-9 cursor-pointer items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
>
  <Icon name="sun" class="block size-[1.2rem] dark:hidden" />
  <Icon name="moon" class="hidden size-[1.2rem] dark:block" />
</button>

<script is:inline define:vars={{ id }}>
  const setToggleListener = () => {
    const toggleBtn = document.getElementById(id);
    const handleToggleClick = () => {
      const element = document.documentElement;

      element.classList.add("theme-transition-lock");
      element.classList.toggle("dark");

      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");

      setTimeout(() => {
        element.classList.remove("theme-transition-lock");
      }, 10);
    };

    toggleBtn?.addEventListener("click", handleToggleClick);
  };

  setToggleListener();
  document.addEventListener("astro:after-swap", setToggleListener);
</script>
