---
import Section from "./Section.astro";
import { awards } from "@cv";
---

<Section className={Astro.props.className} title="Awards">
  <ul class="space-y-6">
    {
      awards.map(({ title, date, awarder }) => (
        <li class="flex gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-0.5 hidden h-5 w-5 shrink-0 text-muted-foreground md:block"
          >
            <circle cx="12" cy="8" r="7" />
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
          </svg>
          <div class="flex w-full flex-col gap-1">
            <div class="flex flex-col items-start justify-between gap-2 sm:flex-row">
              <div class="font-medium leading-snug text-foreground">
                {title}
              </div>
              <time class="shrink-0 text-xs font-medium text-muted-foreground sm:mt-0.5">
                {date}
              </time>
            </div>
            <p class="text-sm text-muted-foreground">{awarder}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
