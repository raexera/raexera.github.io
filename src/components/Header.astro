---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE, LINKS } from "@/consts";
import { cn } from "@/lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<header
  id="header"
  class="fixed top-0 z-50 hidden h-16 w-full md:block print:hidden"
>
  <div class="container mx-auto h-full">
    <div class="relative flex h-full items-center justify-between">
      <a
        href="/"
        class="font-['Yuji_Mai'] text-xl font-bold tracking-tight text-foreground transition-colors hover:text-muted-foreground"
      >
        {SITE.TITLE}
      </a>
      <nav class="hidden items-center gap-2 text-sm md:flex">
        {
          LINKS.map((LINK) => (
            <a
              href={LINK.HREF}
              class={cn(
                "flex h-9 items-center justify-center rounded-md px-4 text-sm font-medium transition-colors",
                pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
                  ? "bg-muted text-foreground"
                  : "text-muted-foreground hover:bg-muted hover:text-foreground",
              )}
            >
              {LINK.TEXT}
            </a>
          ))
        }
      </nav>
      <div class="flex items-center">
        <ThemeToggle id="headerThemeToggle" />
      </div>
    </div>
  </div>
</header>

<script>
  function handleScroll() {
    const header = document.getElementById("header");
    if (header) {
      if (window.scrollY > 0) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    }
  }

  function setupScrollHandler() {
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll);
    handleScroll();
  }
  setupScrollHandler();

  document.addEventListener("astro:after-swap", setupScrollHandler);
</script>
