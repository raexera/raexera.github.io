---
import { cn } from "@/lib/utils";

type Props = {
  name: string;
  className?: string;
};

const { name, className } = Astro.props;
---

<span
  class={cn(
    "inline-flex items-center rounded-lg border border-border bg-muted/20 px-2.5 py-1 text-xs font-medium text-muted-foreground",
    className,
  )}
>
  {name}
</span>
