---
import ExpandButton from "./ExpandButton";
import Section from "./Section.astro";
import { work } from "@cv";
---

<Section className={Astro.props.className} title="Experience">
  <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-[auto_auto_1fr] sm:gap-x-8">
    {
      work.map(
        (
          {
            name,
            startDate,
            endDate,
            position,
            summary,
            responsibilities,
            url,
            location,
            location_type,
          },
          index,
        ) => {
          const isLastItem = index === work.length - 1;
          const isCurrent = !endDate;

          const d1 = new Date(startDate);
          const d2 = endDate ? new Date(endDate) : new Date();

          const dateOptions: Intl.DateTimeFormatOptions = {
            month: "short",
            year: "numeric",
          };

          const formattedStartDate = d1.toLocaleString("en-US", dateOptions);
          const formattedEndDate = endDate
            ? d2.toLocaleString("en-US", dateOptions)
            : "Present";

          let years = d2.getFullYear() - d1.getFullYear();
          let months = d2.getMonth() - d1.getMonth();

          if (months < 0) {
            years--;
            months += 12;
          }

          if (!endDate) {
            months += 1;
            if (months === 12) {
              years += 1;
              months = 0;
            }
          }

          const durationParts = [];
          if (years > 0) {
            durationParts.push(`${years} yr${years > 1 ? "s" : ""}`);
          }
          if (months > 0) {
            durationParts.push(`${months} mo${months > 1 ? "s" : ""}`);
          }
          const duration = durationParts.join(" ");

          return (
            <>
              {/* Datetime Area */}
              <div class="mt-2 flex flex-col text-xs font-medium text-muted-foreground">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-center">
                  <time datetime={startDate}>{formattedStartDate}</time>
                  <span class="hidden sm:inline-block">-</span>

                  {isCurrent ? (
                    <span class="font-semibold text-foreground">Present</span>
                  ) : (
                    <time datetime={endDate}>{formattedEndDate}</time>
                  )}
                </div>
                {duration && <span class="mt-1 font-normal text-muted-foreground/70">{duration}</span>}
              </div>

              {/* Structural Timeline */}
              <div class="relative hidden w-2.5 flex-col items-center sm:flex">

                {!isLastItem && (
                  <div class="absolute -bottom-3 top-3 left-1/2 w-px -translate-x-1/2 bg-border" />
                )}

                {/* Status Indicator - mt-[11px] provides the precise vertical center for text-base titles */}
                {isCurrent ? (
                  <div class="relative z-10 mt-[11px] flex h-2.5 w-2.5 shrink-0 items-center justify-center rounded-full bg-card ring-4 ring-card">
                    <span class="relative flex size-2 shrink-0">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
                      <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
                    </span>
                  </div>
                ) : (
                  <div class="relative z-10 mt-[11px] h-2.5 w-2.5 shrink-0 rounded-full border border-border bg-card ring-4 ring-card" />
                )}
              </div>

              {/* Content Area */}
              <div class={isLastItem ? "" : "mb-10"}>

                {/* Header (Title & Company) */}
                <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
                  <h3 class="text-base font-semibold text-foreground leading-snug">{position}</h3>
                  <span class="hidden text-muted-foreground sm:inline">·</span>
                  {url ? (
                    <a
                      class="group inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {name}
                      <svg
                        class="h-3 w-3 -translate-x-1 translate-y-1 -rotate-45 opacity-0 transition-all group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
                        viewBox="0 0 13 15"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <g
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="5.33 0 10.83 5.5 5.33 11"></polyline>
                          <line x1="10.83" y1="5.5" x2="0.83" y2="5.17"></line>
                        </g>
                      </svg>
                    </a>
                  ) : (
                    <span class="text-sm font-medium text-muted-foreground">{name}</span>
                  )}
                </div>

                {/* Location Meta */}
                {(location || location_type) && (
                  <div class="mt-1 text-xs text-muted-foreground">
                    {location} {location && location_type && " • "} {location_type}
                  </div>
                )}

                {/* Description & Responsibilities */}
                <div class="mt-4 flex flex-col gap-4 text-sm text-muted-foreground">
                  {summary && (
                    <div class="leading-relaxed">
                      {Array.isArray(summary) ? (
                        <ul class="flex flex-col gap-2">
                          {summary.map((item) => <li>{item}</li>)}
                        </ul>
                      ) : (
                        <p>{summary}</p>
                      )}
                    </div>
                  )}

                  {responsibilities && (
                    <ExpandButton client:load>
                      <div class="mt-3 flex flex-col gap-2">
                        <span class="font-medium text-foreground">Key Responsibilities:</span>
                        <ul class="ml-4 list-outside list-disc space-y-1.5 marker:text-muted-foreground/50">
                          {responsibilities.map((responsibility) => (
                            <li class="pl-1 leading-relaxed">{responsibility}</li>
                          ))}
                        </ul>
                      </div>
                    </ExpandButton>
                  )}
                </div>
              </div>
            </>
          );
        },
      )
    }
  </div>
</Section>
