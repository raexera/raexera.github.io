---
import ThemeToggle from "./ThemeToggle.astro";
import { LINKS } from "@/consts";
import { cn } from "@/lib/utils";

const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
---

<div
  class="fixed bottom-0 left-1/2 z-50 flex h-16 w-[calc(100%-2rem)] max-w-5xl -translate-x-1/2 items-end md:hidden"
>
  <div
    class="flex w-full items-center gap-1 rounded-t-2xl border-x border-t border-border bg-background/80 px-2 pt-3 pb-3 backdrop-blur-md"
  >
    <nav class="flex flex-1 gap-1">
      {
        LINKS.map((LINK) => (
          <a
            href={LINK.HREF}
            class={cn(
              "flex h-9 flex-1 items-center justify-center rounded-lg px-1 text-sm font-medium transition-colors",
              pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
                ? "bg-muted text-foreground"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            )}
          >
            {LINK.TEXT}
          </a>
        ))
      }
    </nav>
    <div class="flex shrink-0 items-center">
      <ThemeToggle id="navbarThemeToggle" />
    </div>
  </div>
</div>
